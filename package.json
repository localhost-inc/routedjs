{
  "name": "routedjs",
  "version": "0.1.6",
  "type": "module",
  "description": "File-system routing for APIs. Drop a file, get an endpoint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/localhost-inc/routedjs"
  },
  "homepage": "https://github.com/localhost-inc/routedjs#readme",
  "bugs": {
    "url": "https://github.com/localhost-inc/routedjs/issues"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./hono": {
      "bun": "./src/frameworks/hono.ts",
      "import": {
        "types": "./dist/frameworks/hono.d.ts",
        "default": "./dist/frameworks/hono.js"
      }
    },
    "./koa": {
      "bun": "./src/frameworks/koa.ts",
      "import": {
        "types": "./dist/frameworks/koa.d.ts",
        "default": "./dist/frameworks/koa.js"
      }
    },
    "./elysia": {
      "bun": "./src/frameworks/elysia.ts",
      "import": {
        "types": "./dist/frameworks/elysia.d.ts",
        "default": "./dist/frameworks/elysia.js"
      }
    },
    "./express": {
      "bun": "./src/frameworks/express.ts",
      "import": {
        "types": "./dist/frameworks/express.d.ts",
        "default": "./dist/frameworks/express.js"
      }
    },
    "./openapi": {
      "bun": "./src/openapi/index.ts",
      "import": {
        "types": "./dist/openapi/index.d.ts",
        "default": "./dist/openapi/index.js"
      }
    },
    "./client": {
      "bun": "./src/client/index.ts",
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    }
  },
  "bin": {
    "routed": "bin/routed"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "router",
    "file-system-routing",
    "api",
    "rest",
    "hono",
    "express",
    "koa",
    "elysia",
    "codegen",
    "openapi",
    "zod",
    "valibot",
    "arktype",
    "standard-schema",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "bench": "bun run bench/index.ts",
    "examples:generate": "bun run scripts/generate-examples.ts",
    "prepublishOnly": "bun run examples:generate && bun run build && bun test"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "chokidar": "^4.0.0"
  },
  "peerDependencies": {
    "hono": "^4",
    "elysia": "^1",
    "express": "^5",
    "koa": "^2 || ^3",
    "typescript": "^5",
    "zod-to-json-schema": "^3"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.2",
    "elysia": "^1.4.28",
    "express": "^5.2.1",
    "hono": "4.12.9",
    "koa": "^3.2.0",
    "mitata": "^1.0.34",
    "tsup": "^8.5.1",
    "zod": "^4"
  }
}
