{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "routedjs": ["./src/index.ts"],
      "routedjs/hono": ["./src/frameworks/hono.ts"],
      "routedjs/express": ["./src/frameworks/express.ts"],
      "routedjs/koa": ["./src/frameworks/koa.ts"],
      "routedjs/elysia": ["./src/frameworks/elysia.ts"],
      "routedjs/openapi": ["./src/openapi/index.ts"],
      "routedjs/client": ["./src/client/index.ts"]
    }
  }
}
